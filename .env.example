# Server-side environment variables for /api/contact.
# Set these in the Vercel project settings (Environment Variables) — never in frontend code.
# This file contains names only; do not put real values here or commit a .env file.

# Required: API key for the Resend email API (https://resend.com). Without it the form
# returns an honest "temporarily unavailable" error and offers WhatsApp/email instead.
RESEND_API_KEY=

# Optional: where enquiries are delivered (default: afradigital.hello@gmail.com)
CONTACT_TO_EMAIL=

# Optional: sender shown on enquiry emails. Default "AFRA DIGITAL Website <onboarding@resend.dev>"
# only delivers to the email address that owns the Resend account. To use another sender,
# verify a domain in Resend (requires DNS records) and set e.g. "AFRA DIGITAL <website@afra-digital.com>".
CONTACT_FROM_EMAIL=

# Optional: comma-separated extra allowed Origins (same-origin requests are always allowed).
CONTACT_ALLOWED_ORIGINS=

# Testing only — points the function at the local mock provider. Never set in production.
RESEND_API_URL=
