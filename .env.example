# Server-side environment variables for /api/contact.
# Set these in the Vercel project settings (Environment Variables) — never in frontend code.
# This file contains names only; do not put real values here or commit a .env file.

# Required: Resend API key (sending access). Set separately for Preview and Production in Vercel, then redeploy.
# Without it the form returns an honest "temporarily unavailable" error and offers WhatsApp/email instead.
RESEND_API_KEY=

# Optional: where enquiries are delivered (default: afradigital.hello@gmail.com)
CONTACT_TO_EMAIL=

# Optional: sender shown on enquiry emails. Default: "AFRA DIGITAL Website <website@afra-digital.com>".
# Must be an address on the domain verified in Resend (CONTACT_SENDER_DOMAIN). Any local part works on a
# verified domain. The resend.dev test sender is refused: it only delivers to the Resend account owner.
CONTACT_FROM_EMAIL=

# Optional: the domain verified in Resend (default: afra-digital.com). The sender must be on it.
CONTACT_SENDER_DOMAIN=

# Optional: comma-separated extra allowed Origins (same-origin requests are always allowed).
CONTACT_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Analytics (Phase 03). Read by /api/analytics-config; nothing loads before visitor consent.
# GA4 Measurement ID (public identifier, not a secret). Empty = Google Analytics off.
GA4_MEASUREMENT_ID=
# Vercel Speed Insights: "on" | "off". Default: on when running on Vercel.
SPEED_INSIGHTS=
# Kill switch: "1" disables all analytics and hides the consent banner.
ANALYTICS_DISABLED=

# Testing only — points the function at the local mock provider. Never set in production.
RESEND_API_URL=
